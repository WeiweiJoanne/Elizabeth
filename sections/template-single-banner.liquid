{% if section.settings.image != blank %}
  <section class="mt-12 mb-12 single-banner">
    <div class="mx-auto container">
      <h2 class="text-2xl font-black text-center mb-2">{{ section.settings.title }}</h2>
      <a href="{{ section.settings.link }}" class="overflow-hidden block">

        <img class="transition duration-300 hover:scale-105"
          src="{{ section.settings.image | image_url: width: 1600  }}"
          width="1600"
          height=""
          alt="">
      </a>
    </div>
  </section>
{% endif %}




{% schema %}
  {
    "name": "Single banner template",
    "settings": [
      {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Title"
      }, {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
      }, {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "presets": [
      {
        "name": "Single banner"
      }
    ]
  }
{% endschema %}