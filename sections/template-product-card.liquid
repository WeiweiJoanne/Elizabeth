{% assign my_collection = collections['all'] %}
{% if my_collection and my_collection.products.size > 0 %}
{% paginate my_collection.products by 2 %}
<div class="container mx-auto py-4">
  <div class="flex flex-col mt-6 gap-4 lg:flex-row md:justify-center">

    {% for product in my_collection.products %}
    <div class="product-cards w-full lg:w-1/2 ">
      {% form 'product', product, class: 'h-full' %}
<div class="mx-4 h-full">
      <div
        class="flex flex-col md:flex-row lg:flex-col xl:flex-row gap-4 h-full product-card justify-between xl:justify-center xl:justify-between p-6 items-center xl:items-stretch border-2 border-solid border-slate-200 rounded-xl">
        <div class="w-full xl:w-2/5 max-w-[360px] -px-4 ">
          <a href="{{product.url}}" class="">
            <img class="w-full" src="{{ product.featured_image | image_url: width: 360 }}"
              alt="{{ product.featured_image.alt }}">
          </a>
        </div>
        <div class="w-full xl:w-3/5 flex flex-col flex justify-between">
          <h2 class="text-lg font-black md:text-xl">
            {{ product.title }}
          </h2>

          <div class="mt-12 xl:mt-auto text-sm xl:text-base">
            {% assign product_price = product.selected_or_first_available_variant %}
            <div class="flex items-end justify-start">


              <span class="text-base text-gray-500 line-through leading-none mr-2">{{ product_price.compare_at_price |  money }}</span>

              <span class="text-3xl font-black leading-none italic text-red-600">{{ product_price.price | money }}</span>

              {% if product_price.price < product_price.compare_at_price %}

                <span class="px-5 py-1 text-sm font-bold bg-red-500 rounded-full text-white mx-4">
                Sale
                </span>

                {% endif %}
            </div>
            <input type="hidden" name="quantity" value="1" />
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />

            <button type="submit" name="checkout"
              class="w-full mt-2 bg-orange-600 px-12 py-2 text-white rounded-xl text-xl font-black">Buy Now</button>
          </div>

        </div>
      </div>
      </div>
      

      {% endform %}
    </div>

    {% endfor %}


  </div>
</div>
{% endpaginate %}
{% else %}
<p>There is no match product.</p>
{% endif %}