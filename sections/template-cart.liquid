{% if cart.item_count > 0 %}
    <div class="p-4 pt-24">
        {% comment %} <div class="max-w-6xl flex- flex-col my-10 mx-auto">
            <div class="flex-1">
                <div class="flex items-end justify-between my-5">
                    <h1 class="text-3xl">Your cart</h1>
                    <a href="{{ routes.all_products_collectiom_url }}" class="text-blue-600 hover:text-blue-800 font-medium underline">Continue shopping</a>
                </div>
            </div>
        </div> {% endcomment %}

        <div class="max-w-6xl flex flex-col my-10 mx-auto">
            <form action="{{ routes.cart_url }}" method="POST" novalidate>
                <table class="table-auto divide-y divide-gray-200 my-4 w-full">
                    <thead>
                        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Product</th>
                        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Quantity</th>
                        <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Total Price</th>
                    </thead>
                    <tbody>
                        {% for item in cart.items %}
                            <tr class="table-row">
                                <td class="py-4 px-6 flex flex-col justify-center">
                                    <a href="{{ item.url }}" class="flex items-center gap-4">
                                        {% if item.image %}
                                            <img src="{{ item | img_url: 'small' }}" alt="{{ item.title | escape }}" class="w-20 h-20 object-cover border">
                                        {% else %}
                                            {{ 'product-1' | placeholder_svg_tag: 'w-20 h-20 object-cover border' }}
                                        {% endif %}
                                        <h2 href="{{ item.url }}" class="my-1 text-lg ">{{ item.product.title | truncatewords: 12}}</h2>
                                    </a>
                                </td>
                                {% comment %} <td class="py-4 px-6 flex flex-col justify-center">
                                    <a href="{{ item.url }}" class="my-1">{{ item.product.title | truncatewords: 12}}</a>
                                    {% comment %} <span class="text-sm text-gray-500 my-1">{{ item.variant.title }}</span> {% endcomment %}
                                   
                                </td> {% endcomment %}
                                <td class="py-4 px-6">
                                    <input type="number" name="updates[]" id="updates_{{ forloop.index }}" value="{{ item.quantity }}" min="0" class="w-20 border p-2">
                                </td>
                                <td class="py-4 px-6">
                                    {{ item.line_price | money }}
                                </td>
                                <td class="py-4 px-6">
                                    <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0" class="text-sm font-medium text-red-500 my-1">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
  <path stroke-linecap="round" stroke-linejoin="round" d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
</svg>

                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                <div class="my-2 text-right">

                    <button type="submit" name="checkout" class=" p-3 border border-red-600 font-medium rounded-lg bg-red-600 text-white">Checkout</button>
                </div>
                                    
            
            </form>
        </div>
    </div>
{% else %}
    <h1>Your cart is empty</h1>
{% endif %}
