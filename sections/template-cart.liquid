{% if cart.item_count > 0 %}
<div class="p-4 pt-24" data-qty="{{cart.item_count}}">
    {% comment %} <div class="max-w-6xl flex- flex-col my-10 mx-auto">
        <div class="flex-1">
            <div class="flex items-end justify-between my-5">
                <h1 class="text-3xl">Your cart</h1>
                <a href="{{ routes.all_products_collectiom_url }}"
                    class="text-blue-600 hover:text-blue-800 font-medium underline">Continue shopping</a>
            </div>
        </div>
    </div> {% endcomment %}

    <div class="max-w-6xl flex flex-col my-10 mx-auto">
        <form action="{{ routes.cart_url }}" method="POST" novalidate>
            <table class="table-auto divide-y divide-gray-200 my-4 w-full cart-table">
                <thead>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Product</th>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Quantity</th>
                    <th class="px-6 py-3 text-left text-sm font-medium text-gray-500">Total Price</th>
                </thead>
                <tbody>
                    {% for item in cart.items %}
                    <tr class="table-row">
                        <td class="py-4 px-6 flex flex-col justify-center">
                            <a href="{{ item.url }}" class="flex items-center gap-4">
                                {% if item.image %}
                                <img src="{{ item | img_url: 'small' }}" alt="{{ item.title | escape }}" class="w-20 h-20 object-cover border">
                                {% else %}
                                {{ 'product-1' | placeholder_svg_tag: 'w-20 h-20 object-cover border' }}
                                {% endif %}
                                <h2 href="{{ item.url }}" class="my-1 text-lg ">{{ item.product.title | truncatewords: 12}}</h2>
                            </a>
                        </td>
                        {% comment %} <td class="py-4 px-6 flex flex-col justify-center">
                            <a href="{{ item.url }}" class="my-1">{{ item.product.title | truncatewords: 12}}</a>
                            <span class="text-sm text-gray-500 my-1">{{ item.variant.title }}</span>

                        </td> {% endcomment %}
                        <td class="py-4 px-6 ">
                            <input type="number" class="qty p-2 w-20" name="updates[]" id="{{ forloop.index }}"
                                data-price="{{ item.price | money_without_currency }}" value="{{ item.quantity }}">
                        </td>
                        <td class="py-4 px-6 product-total-money">
                            {{ item.line_price | money_without_trailing_zeros }}
                        </td>
                        <td class="py-4 px-6">
                            <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                                class="text-sm font-medium text-red-500 my-1">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"
                                    stroke-width="1.5" stroke="currentColor" class="size-6">
                                    <path stroke-linecap="round" stroke-linejoin="round"
                                        d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                                </svg>

                            </a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            <div class="my-2 text-right">

                <button type="submit" name="checkout"
                    class=" p-3 border border-red-600 font-medium rounded-lg bg-red-600 text-white">Checkout</button>
            </div>


        </form>
    </div>
</div>
{% else %}
<div class="p-4 pt-24" data-qty="{{cart.item_count}}">
    <div class="max-w-6xl flex flex-col my-10 mx-auto">
        <h1 class="font-black text-xl py-4 px-6 ">Your cart is empty</h1>
        
    </div>
</div>
{% endif %}

<script>
    const qty = document.querySelector(".cart-table")
    qty.addEventListener("change", e => {
        console.log(e.target.classList.contains("qty"))
        if (e.target.classList.contains("qty")) {
            const qty = e.target.value
            // const price = parseFloat(e.target.dataset.price) || 0;
            // const totalPrice = qty * price;
    
            e.target.closest('tr').querySelector(".product-total-money").textContent = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD'
            }).format(0);
            // e.target.closest('tr').querySelector(".product-total-money").textContent = new Intl.NumberFormat('en-US', {
            //     style: 'currency',
            //     currency: 'USD',
            //     minimumFractionDigits: 0, // 沒有小數部分時不顯示
            //     maximumFractionDigits: 2  // 最多顯示到 2 位小數
            // }).format(totalPrice);

            const id = e.target.getAttribute('id'); // 購物車中的行索引


            // 發送 AJAX 請求更新購物車
        fetch('/cart/change.js', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({
                line: id,
                quantity: qty
            }),
        })
        .then(response => response.json())
        .then(cart => {
            console.log('Cart updated:', cart);
            // 更新總價顯示
            // const row = this.closest('tr');
            const price = parseFloat(e.target.dataset.price) || 0;
            // const productPrice = parseFloat(row.querySelector('.product-price').textContent.replace(/[^0-9.-]+/g, '')) || 0;
            const totalPrice = price * qty;
            e.target.closest('tr').querySelector(".product-total-money").textContent = new Intl.NumberFormat('en-US', {
                style: 'currency',
                currency: 'USD',
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }).format(totalPrice);
        })
        .catch(error => {
            console.error('Error updating cart:', error);
        });



        }
    })
</script>